# Building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Hier ist %s. Wir empfangen gerade keine Besucher."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Willkommen bei %s. Die Archive sind öffentlich zugänglich."

msgid "This is the %s police station. State your business."
msgstr "Hier ist die Polizeistation %s. Was ist Ihr Anliegen?"

msgid "City Records Office. How can we help?"
msgstr "Stadtarchiv. Wie können wir helfen?"

msgid "%s. Come in and browse."
msgstr "%s. Kommen Sie herein und sehen Sie sich um."

msgid "Welcome to %s! What'll it be?"
msgstr "Willkommen bei %s! Was darf es sein?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Willkommen bei %s. Wie können wir Ihnen heute helfen?"

msgid "%s. You shouldn't be here."
msgstr "%s. Sie sollten nicht hier sein."

msgid "You leave the building."
msgstr "Sie verlassen das Gebäude."

# Shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Willkommen bei %s! Was kann ich für Sie tun?"

msgid "Goodbye!"
msgstr "Auf Wiedersehen!"

msgid "Buy/Sell"
msgstr "Kaufen/Verkaufen"

msgid "Any news?"
msgstr "Irgendwelche Neuigkeiten?"

msgid "Leave"
msgstr "Gehen"

msgid "You leave."
msgstr "Sie gehen."

msgid "Trade"
msgstr "Handeln"

msgid "Ask around"
msgstr "Sich umhören"

# Errors
msgid "Failed to initialize renderer"
msgstr "Renderer konnte nicht initialisiert werden"

msgid "Missing game data"
msgstr "Fehlende Spieldaten"

msgid "No game data found. Please set the data path in Settings or use --data on the command line."
msgstr "Keine Spieldaten gefunden. Bitte setzen Sie den Datenpfad in den Einstellungen oder verwenden Sie --data auf der Kommandozeile."

msgid "You can also change the data path in Settings."
msgstr "Sie können den Datenpfad auch in den Einstellungen ändern."

msgid "Missing Liberation data"
msgstr "Fehlende Liberation-Daten"
