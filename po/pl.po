#. Liberation building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "To jest %s. Nie przyjmujemy teraz odwiedzających."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Witamy w %s. Archiwa są dostępne publicznie."

msgid "This is the %s police station. State your business."
msgstr "To jest posterunek policji %s. W jakiej sprawie?"

msgid "City Records Office. How can we help?"
msgstr "Biuro Ewidencji Miasta. Jak możemy pomóc?"

msgid "This is a private residence. What do you want?"
msgstr "To jest prywatna posiadłość. Czego chcesz?"

msgid "Welcome to %s. This area is restricted."
msgstr "Witamy w %s. Ten obszar jest zastrzeżony."

msgid "%s. Come in and browse."
msgstr "%s. Wejdź i rozejrzyj się."

msgid "Welcome to %s! What'll it be?"
msgstr "Witamy w %s! Co podać?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Witamy w %s. Jak możemy dziś pomóc?"

msgid "%s. You shouldn't be here."
msgstr "%s. Nie powinieneś tu być."

msgid "Take a look at what I have."
msgstr "Spójrz na to, co mam."

msgid "I might have heard something. Check back later."
msgstr "Może coś słyszałem. Wpadnij później."

msgid "You leave the building."
msgstr "Opuszczasz budynek."

#. Liberation shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Witamy w %s! Co mogę dla ciebie zrobić?"

msgid "Goodbye!"
msgstr "Do widzenia!"

msgid "Buy/Sell"
msgstr "Kup/Sprzedaj"

msgid "Any news?"
msgstr "Jakieś wieści?"

msgid "Leave"
msgstr "Odejdź"

#. Liberation NPC dialogue
msgid "You leave."
msgstr "Odchodzisz."

msgid "Trade"
msgstr "Handel"

msgid "Ask around"
msgstr "Wypytaj"

#. Error messages
msgid "Failed to initialize renderer"
msgstr "Nie udało się uruchomić renderera"

msgid "Missing game data"
msgstr "Brak danych gry"

msgid "No game data found. Please set the data path in Settings or use --data on the command line."
msgstr "Nie znaleziono danych gry. Ustaw ścieżkę danych w Ustawieniach lub użyj --data w wierszu poleceń."

msgid "You can also change the data path in Settings."
msgstr "Możesz też zmienić ścieżkę danych w Ustawieniach."

msgid "Missing Liberation data"
msgstr "Brak danych Liberation"
