#. Liberation building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "To jest %s. Nie przyjmujemy teraz gosci."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Witamy w %s. Archiwa sa dostepne publicznie."

msgid "This is the %s police station. State your business."
msgstr "To jest komisariat %s. W jakiej sprawie?"

msgid "City Records Office. How can we help?"
msgstr "Biuro Ewidencji Miejskiej. Czym mozemy pomoc?"

msgid "%s. Come in and browse."
msgstr "%s. Wejdz i rozejrzyj sie."

msgid "Welcome to %s! What'll it be?"
msgstr "Witamy w %s! Co podac?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Witamy w %s. Czym mozemy dzis pomoc?"

msgid "%s. You shouldn't be here."
msgstr "%s. Nie powinno cie tu byc."

msgid "You leave the building."
msgstr "Opuszczasz budynek."

#. Liberation shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Witamy w %s! Czym moge sluzyc?"

msgid "Goodbye!"
msgstr "Do widzenia!"

msgid "Buy/Sell"
msgstr "Kup/Sprzedaj"

msgid "Any news?"
msgstr "Jakies wiesci?"

msgid "Leave"
msgstr "Wyjdz"

#. Liberation NPC dialogue
msgid "You leave."
msgstr "Odchodzisz."

msgid "Trade"
msgstr "Handel"

msgid "Ask around"
msgstr "Popytaj"

#. Error messages
msgid "Failed to initialize renderer"
msgstr "Nie udalo sie uruchomic renderera"

msgid "Missing game data"
msgstr "Brak danych gry"

msgid "No game data found. Please set the data path in Settings or use --data on the command line."
msgstr "Nie znaleziono danych gry. Ustaw sciezke danych w Ustawieniach lub uzyj --data w wierszu polecen."

msgid "You can also change the data path in Settings."
msgstr "Mozesz tez zmienic sciezke danych w Ustawieniach."

msgid "Missing Liberation data"
msgstr "Brak danych Liberation"
