msgid "ZIP archives found: %d"
msgstr "ZIP-arkiv hittade: %d"

msgid "VERIFICATION"
msgstr "VERIFIERING"

msgid "Files identified by SHA-256 content hash, not filename."
msgstr "Filer identifieras med SHA-256-innehållshash, inte filnamn."

msgid "Nested ZIPs, ADF disk images, and ISO tracks are scanned."
msgstr "Nästlade ZIP, ADF-diskavbilder och ISO-spår skannas."

msgid "No filenames are trusted; only content determines identity."
msgstr "Inga filnamn litas på; bara innehållet avgör identiteten."

#. Setup popup
msgid "GAME DATA NOT FOUND"
msgstr "SPELDATA HITTADES INTE"

msgid "OpenCaptive needs original game data files to run."
msgstr "OpenCaptive behöver originalspeldata för att köras."

msgid "Place your game data in the following folder:"
msgstr "Placera din speldata i följande mapp:"

msgid "Supported formats: ZIP archives, ADF, ISO, raw files."
msgstr "Format som stöds: ZIP-arkiv, ADF, ISO, råfiler."

msgid "Files are identified by SHA-256 hash, not filename."
msgstr "Filer identifieras med SHA-256-hash, inte filnamn."

msgid "You can change the data path in Settings (S)."
msgstr "Du kan ändra datasökvägen i Inställningar (S)."

msgid "PRESS ANY KEY TO CONTINUE"
msgstr "TRYCK VALFRI TANGENT FÖR ATT FORTSÄTTA"
