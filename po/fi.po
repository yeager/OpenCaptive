# Building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Taemae on %s. Emme ota vierailijoita vastaan juuri nyt."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Tervetuloa kohteeseen %s. Arkistot ovat julkisesti saatavilla."

msgid "This is the %s police station. State your business."
msgstr "Taemae on %s poliisiasema. Kertokaa asianne."

msgid "City Records Office. How can we help?"
msgstr "Kaupungin arkistotoimisto. Miten voimme auttaa?"

msgid "%s. Come in and browse."
msgstr "%s. Tule sisaeaen ja katso ympaerilesi."

msgid "Welcome to %s! What'll it be?"
msgstr "Tervetuloa kohteeseen %s! Mitae saisi olla?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Tervetuloa kohteeseen %s. Miten voimme auttaa taenaean?"

msgid "%s. You shouldn't be here."
msgstr "%s. Sinun ei pitaeisi olla taeaellae."

msgid "You leave the building."
msgstr "Poistut rakennuksesta."

# Shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Tervetuloa kohteeseen %s! Mitae voin tehdae hyvaeksesi?"

msgid "Goodbye!"
msgstr "Naekemiin!"

msgid "Buy/Sell"
msgstr "Osta/Myy"

msgid "Any news?"
msgstr "Mitaen uutta?"

msgid "Leave"
msgstr "Laehde"

msgid "You leave."
msgstr "Laehdet."

msgid "Trade"
msgstr "Kauppa"

msgid "Ask around"
msgstr "Kysy ympaerilta"

# Errors
msgid "Failed to initialize renderer"
msgstr "Renderoeijan alustaminen epaonnistui"

msgid "Missing game data"
msgstr "Pelidata puuttuu"

msgid "No game data found. Please set the data path in Settings or use --data on the command line."
msgstr "Pelidataa ei loeydy. Aseta datapolku Asetuksissa tai kaeytae --data komentorivillae."

msgid "You can also change the data path in Settings."
msgstr "Voit myoes muuttaa datapolkua Asetuksissa."

msgid "Missing Liberation data"
msgstr "Liberation-data puuttuu"
