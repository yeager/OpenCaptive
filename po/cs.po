# Building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Toto je %s. Právě nepřijímáme návštěvy."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Vítejte v %s. Archivy jsou veřejně přístupné."

msgid "This is the %s police station. State your business."
msgstr "Toto je policejní stanice %s. Jaký je váš požadavek?"

msgid "City Records Office. How can we help?"
msgstr "Městský archiv. Jak vám můžeme pomoci?"

msgid "%s. Come in and browse."
msgstr "%s. Pojďte dál a rozhlédněte se."

msgid "Welcome to %s! What'll it be?"
msgstr "Vítejte v %s! Co to bude?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Vítejte v %s. Jak vám dnes můžeme pomoci?"

msgid "%s. You shouldn't be here."
msgstr "%s. Neměli byste tu být."

msgid "You leave the building."
msgstr "Opouštíte budovu."

# Shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Vítejte v %s! Co pro vás mohu udělat?"

msgid "Goodbye!"
msgstr "Nashledanou!"

msgid "Buy/Sell"
msgstr "Koupit/Prodat"

msgid "Any news?"
msgstr "Nějaké novinky?"

msgid "Leave"
msgstr "Odejít"

msgid "You leave."
msgstr "Odcházíte."

msgid "Trade"
msgstr "Obchod"

msgid "Ask around"
msgstr "Poptat se"

# Errors
msgid "Failed to initialize renderer"
msgstr "Nepodařilo se inicializovat renderer"

msgid "Missing game data"
msgstr "Chybí herní data"

msgid "No game data found. Please set the data path in Settings or use --data on the command line."
msgstr "Nebyla nalezena žádná herní data. Nastavte cestu k datům v Nastavení nebo použijte --data na příkazovém řádku."

msgid "You can also change the data path in Settings."
msgstr "Cestu k datům můžete změnit také v Nastavení."

msgid "Missing Liberation data"
msgstr "Chybí data Liberation"
