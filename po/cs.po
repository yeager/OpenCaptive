# Building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Toto je %s. Prave neprijimame navstevy."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Vitejte v %s. Archivy jsou verejne pristupne."

msgid "This is the %s police station. State your business."
msgstr "Toto je policejni stanice %s. Jaky je vas pozadavek?"

msgid "City Records Office. How can we help?"
msgstr "Mestsky archiv. Jak vam muzeme pomoci?"

msgid "%s. Come in and browse."
msgstr "%s. Pojdte dal a rozhlednete se."

msgid "Welcome to %s! What'll it be?"
msgstr "Vitejte v %s! Co to bude?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Vitejte v %s. Jak vam dnes muzeme pomoci?"

msgid "%s. You shouldn't be here."
msgstr "%s. Nemeli byste tu byt."

msgid "You leave the building."
msgstr "Opoustite budovu."

# Shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Vitejte v %s! Co pro vas mohu udelat?"

msgid "Goodbye!"
msgstr "Nashledanou!"

msgid "Buy/Sell"
msgstr "Koupit/Prodat"

msgid "Any news?"
msgstr "Nejake novinky?"

msgid "Leave"
msgstr "Odejit"

msgid "You leave."
msgstr "Odchazite."

msgid "Trade"
msgstr "Obchod"

msgid "Ask around"
msgstr "Poptat se"

# Errors
msgid "Failed to initialize renderer"
msgstr "Nepodarilo se inicializovat renderer"

msgid "Missing game data"
msgstr "Chybi herni data"

msgid "No game data found. Please set the data path in Settings or use --data on the command line."
msgstr "Nebyla nalezena zadna herni data. Nastavte cestu k datum v Nastaveni nebo pouzijte --data na prikazovem radku."

msgid "You can also change the data path in Settings."
msgstr "Cestu k datum muzete zmenit take v Nastaveni."

msgid "Missing Liberation data"
msgstr "Chybi data Liberation"
