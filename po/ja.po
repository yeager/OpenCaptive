#. Liberation building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Koko wa %s desu. Ima wa raikyaku wo uketsukete imasen."

msgid "Welcome to %s. The archives are available for public access."
msgstr "%s e youkoso. Aakaibu wa ippan koukai sarete imasu."

msgid "This is the %s police station. State your business."
msgstr "Koko wa %s keisatsusho desu. Goyouken wo douzo."

msgid "City Records Office. How can we help?"
msgstr "Shiyakusho Kiroku Ka desu. Nanika otetsudai shimasu ka?"

msgid "%s. Come in and browse."
msgstr "%s desu. Douzo haitte goran kudasai."

msgid "Welcome to %s! What'll it be?"
msgstr "%s e youkoso! Nani ni shimasu ka?"

msgid "Welcome to %s. How can we help you today?"
msgstr "%s e youkoso. Kyou wa nanika otetsudai shimasu ka?"

msgid "%s. You shouldn't be here."
msgstr "%s desu. Koko ni iru beki dewa arimasen."

msgid "You leave the building."
msgstr "Tatemono wo demashita."

#. Liberation shop
msgid "Welcome to %s! What can I do for you?"
msgstr "%s e youkoso! Nanika otetsudai shimasu ka?"

msgid "Goodbye!"
msgstr "Sayounara!"

msgid "Buy/Sell"
msgstr "Baibai"

msgid "Any news?"
msgstr "Nanika nyuusu wa?"

msgid "Leave"
msgstr "Saru"

#. Liberation NPC dialogue
msgid "You leave."
msgstr "Tachisarimashita."

msgid "Trade"
msgstr "Torihiki"

msgid "Ask around"
msgstr "Kiite mawaru"

#. Error messages
msgid "Failed to initialize renderer"
msgstr "Renderaa no shokika ni shippai shimashita"

msgid "Missing game data"
msgstr "Geemu deeta ga arimasen"

msgid "No game data found. Please set the data path in Settings or use --data on the command line."
msgstr "Geemu deeta ga mitsukarimsen. Settei de deeta pasu wo setteishite kudasai. Matawa komandorain de --data wo shitei shite kudasai."

msgid "You can also change the data path in Settings."
msgstr "Settei de deeta pasu wo henkou suru koto mo dekimasu."

msgid "Missing Liberation data"
msgstr "Liberation deeta ga arimasen"
