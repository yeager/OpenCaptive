#. Liberation building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Dette er %s. Vi tar ikke imot besoekende akkurat na."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Velkommen til %s. Arkivet er tilgjengelig for offentlig innsyn."

msgid "This is the %s police station. State your business."
msgstr "Dette er %s politistasjon. Hva gjelder det?"

msgid "City Records Office. How can we help?"
msgstr "Byens Registerkontor. Hvordan kan vi hjelpe?"

msgid "%s. Come in and browse."
msgstr "%s. Kom inn og se deg rundt."

msgid "Welcome to %s! What'll it be?"
msgstr "Velkommen til %s! Hva skal det vaere?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Velkommen til %s. Hvordan kan vi hjelpe deg i dag?"

msgid "%s. You shouldn't be here."
msgstr "%s. Du burde ikke vaere her."

msgid "You leave the building."
msgstr "Du forlater bygningen."

#. Liberation shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Velkommen til %s! Hva kan jeg gjore for deg?"

msgid "Goodbye!"
msgstr "Ha det bra!"

msgid "Buy/Sell"
msgstr "Kjop/Salg"

msgid "Any news?"
msgstr "Noen nyheter?"

msgid "Leave"
msgstr "Ga"

#. Liberation NPC dialogue
msgid "You leave."
msgstr "Du gar."

msgid "Trade"
msgstr "Handel"

msgid "Ask around"
msgstr "Spor rundt"

#. Error messages
msgid "Failed to initialize renderer"
msgstr "Klarte ikke a initialisere rendereren"

msgid "Missing game data"
msgstr "Manglende spilldata"

msgid "No game data found. Please set the data path in Settings or use --data on the command line."
msgstr "Ingen spilldata funnet. Vennligst sett datastien i Innstillinger eller bruk --data pa kommandolinjen."

msgid "You can also change the data path in Settings."
msgstr "Du kan ogsa endre datastien i Innstillinger."

msgid "Missing Liberation data"
msgstr "Manglende Liberation-data"
