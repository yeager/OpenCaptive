#. Liberation building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Dette er %s. Vi tar ikke imot besøkende akkurat nå."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Velkommen til %s. Arkivet er tilgjengelig for offentlig innsyn."

msgid "This is the %s police station. State your business."
msgstr "Dette er %s politistasjon. Hva gjelder det?"

msgid "City Records Office. How can we help?"
msgstr "Byens Registerkontor. Hvordan kan vi hjelpe?"

msgid "%s. Come in and browse."
msgstr "%s. Kom inn og se deg rundt."

msgid "Welcome to %s! What'll it be?"
msgstr "Velkommen til %s! Hva skal det være?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Velkommen til %s. Hvordan kan vi hjelpe deg i dag?"

msgid "%s. You shouldn't be here."
msgstr "%s. Du burde ikke være her."

msgid "You leave the building."
msgstr "Du forlater bygningen."

#. Liberation shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Velkommen til %s! Hva kan jeg gjøre for deg?"

