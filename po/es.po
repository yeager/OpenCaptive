# Building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Esto es %s. No estamos recibiendo visitantes ahora mismo."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Bienvenido a %s. Los archivos estan disponibles para acceso publico."

msgid "This is the %s police station. State your business."
msgstr "Esta es la comisaria de %s. Diga su asunto."

msgid "City Records Office. How can we help?"
msgstr "Oficina de registros de la ciudad. Como podemos ayudar?"

msgid "%s. Come in and browse."
msgstr "%s. Entre y eche un vistazo."

msgid "Welcome to %s! What'll it be?"
msgstr "Bienvenido a %s! Que va a ser?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Bienvenido a %s. Como podemos ayudarle hoy?"

msgid "%s. You shouldn't be here."
msgstr "%s. No deberia estar aqui."

msgid "You leave the building."
msgstr "Sales del edificio."

# Shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Bienvenido a %s! Que puedo hacer por usted?"

msgid "Goodbye!"
msgstr "Adios!"

msgid "Buy/Sell"
msgstr "Comprar/Vender"

msgid "Any news?"
msgstr "Alguna novedad?"

msgid "Leave"
msgstr "Salir"

msgid "You leave."
msgstr "Te vas."

msgid "Trade"
msgstr "Comerciar"

msgid "Ask around"
msgstr "Preguntar"

# Errors
msgid "Failed to initialize renderer"
msgstr "Error al inicializar el renderer"

msgid "Missing game data"
msgstr "Faltan datos del juego"

msgid "No game data found. Please set the data path in Settings or use --data on the command line."
msgstr "No se encontraron datos del juego. Por favor, establezca la ruta de datos en Ajustes o use --data en la linea de comandos."

msgid "You can also change the data path in Settings."
msgstr "Tambien puede cambiar la ruta de datos en Ajustes."

msgid "Missing Liberation data"
msgstr "Faltan datos de Liberation"
