msgid "ZIP archives found: %d"
msgstr "Archivos ZIP encontrados: %d"

msgid "VERIFICATION"
msgstr "VERIFICACIÓN"

msgid "Files identified by SHA-256 content hash, not filename."
msgstr "Los archivos se identifican por hash SHA-256 del contenido, no por nombre."

msgid "Nested ZIPs, ADF disk images, and ISO tracks are scanned."
msgstr "Se escanean ZIPs anidados, imágenes de disco ADF y pistas ISO."

msgid "No filenames are trusted; only content determines identity."
msgstr "No se confía en los nombres de archivo; solo el contenido determina la identidad."

msgid "GAME DATA NOT FOUND"
msgstr "DATOS DEL JUEGO NO ENCONTRADOS"

msgid "OpenCaptive needs original game data files to run."
msgstr "OpenCaptive necesita los archivos de datos originales del juego para ejecutarse."

msgid "Place your game data in the following folder:"
msgstr "Coloque los datos del juego en la siguiente carpeta:"

msgid "Supported formats: ZIP archives, ADF, ISO, raw files."
msgstr "Formatos compatibles: archivos ZIP, ADF, ISO, archivos sin formato."

msgid "Files are identified by SHA-256 hash, not filename."
msgstr "Los archivos se identifican por hash SHA-256, no por nombre."

msgid "You can change the data path in Settings (S)."
msgstr "Puede cambiar la ruta de datos en Ajustes (S)."

msgid "PRESS ANY KEY TO CONTINUE"
msgstr "PULSE CUALQUIER TECLA PARA CONTINUAR"
