#. Liberation building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Zhe shi %s. Women xianzai bu jiedai fangke."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Huanying lai dao %s. Dang'an dui gonzhong kaifang."

msgid "This is the %s police station. State your business."
msgstr "Zhe shi %s jingchaju. Qing shuo nin de layi."

msgid "City Records Office. How can we help?"
msgstr "Chengshi dang'an shi. You shenme keyi bangmang de?"

msgid "%s. Come in and browse."
msgstr "%s. Qing jin lai kankan."

msgid "Welcome to %s! What'll it be?"
msgstr "Huanying lai dao %s! Nin xiang yao shenme?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Huanying lai dao %s. Jintian you shenme keyi bangmang de?"

msgid "%s. You shouldn't be here."
msgstr "%s. Ni bu yinggai zai zheli."

msgid "You leave the building."
msgstr "Ni likai le dalou."

#. Liberation shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Huanying lai dao %s! You shenme keyi wei nin fuwu de?"

msgid "Goodbye!"
msgstr "Zaijian!"

msgid "Buy/Sell"
msgstr "Mai/Mai"

msgid "Any news?"
msgstr "You shenme xinwen ma?"

msgid "Leave"
msgstr "Likai"

#. Liberation NPC dialogue
msgid "You leave."
msgstr "Ni likai le."

msgid "Trade"
msgstr "Jiaoyi"

msgid "Ask around"
msgstr "Datingsixia"

#. Error messages
msgid "Failed to initialize renderer"
msgstr "Xuanranqi chushihua shibai"

msgid "Missing game data"
msgstr "Quesha youxi shuju"

msgid "No game data found. Please set the data path in Settings or use --data on the command line."
msgstr "Wei zhao dao youxi shuju. Qing zai Shezhi zhong sheding shuju lujing huo zai minglingxing zhong shiyong --data."

msgid "You can also change the data path in Settings."
msgstr "Nin ye keyi zai Shezhi zhong gengai shuju lujing."

msgid "Missing Liberation data"
msgstr "Quesha Liberation shuju"
