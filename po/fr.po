#. Liberation building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Ici %s. Nous ne prenons pas de visiteurs pour le moment."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Bienvenue à %s. Les archives sont accessibles au public."

msgid "This is the %s police station. State your business."
msgstr "Ici le commissariat de %s. Quel est votre problème?"

msgid "City Records Office. How can we help?"
msgstr "Bureau des registres municipaux. Comment pouvons-nous aider?"

msgid "This is a private residence. What do you want?"
msgstr "C'est une résidence privée. Que voulez-vous?"

msgid "Welcome to %s. This area is restricted."
msgstr "Bienvenue à %s. Cette zone est interdite."

msgid "%s. Come in and browse."
msgstr "%s. Entrez et regardez."

msgid "Welcome to %s! What'll it be?"
msgstr "Bienvenue à %s! Ce sera quoi?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Bienvenue à %s. Comment pouvons-nous vous aider aujourd'hui?"

msgid "%s. You shouldn't be here."
msgstr "%s. Vous ne devriez pas être ici."

msgid "Take a look at what I have."
msgstr "Regardez ce que j'ai."

msgid "I might have heard something. Check back later."
msgstr "J'ai peut-être entendu quelque chose. Revenez plus tard."

msgid "You leave the building."
msgstr "Vous quittez le bâtiment."

#. Liberation shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Bienvenue à %s! Que puis-je faire pour vous?"

msgid "Goodbye!"
msgstr "Au revoir!"

msgid "Buy/Sell"
msgstr "Acheter/Vendre"

msgid "Any news?"
msgstr "Des nouvelles?"

msgid "Leave"
msgstr "Partir"

#. Liberation NPC dialogue
msgid "You leave."
msgstr "Vous partez."

msgid "Trade"
msgstr "Commercer"

msgid "Ask around"
msgstr "Se renseigner"

