# Building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Dette er %s. Vi tager ikke imod besøgende lige nu."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Velkommen til %s. Arkiverne er offentligt tilgængelige."

msgid "This is the %s police station. State your business."
msgstr "Dette er %s politistation. Hvad drejer det sig om?"

msgid "City Records Office. How can we help?"
msgstr "Byens arkivkontor. Hvordan kan vi hjælpe?"

msgid "%s. Come in and browse."
msgstr "%s. Kom ind og se dig omkring."

msgid "Welcome to %s! What'll it be?"
msgstr "Velkommen til %s! Hvad skal det være?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Velkommen til %s. Hvordan kan vi hjælpe dig i dag?"

msgid "%s. You shouldn't be here."
msgstr "%s. Du burde ikke være her."

msgid "You leave the building."
msgstr "Du forlader bygningen."

# Shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Velkommen til %s! Hvad kan jeg gøre for dig?"

msgid "Goodbye!"
msgstr "Farvel!"

msgid "Buy/Sell"
msgstr "Køb/Sælg"

msgid "Any news?"
msgstr "Nogle nyheder?"

msgid "Leave"
msgstr "Gå"

msgid "You leave."
msgstr "Du går."

msgid "Trade"
msgstr "Handel"

msgid "Ask around"
msgstr "Spørg omkring"

# Errors
msgid "Failed to initialize renderer"
msgstr "Kunne ikke initialisere rendereren"

msgid "Missing game data"
msgstr "Manglende spildata"

msgid "No game data found. Please set the data path in Settings or use --data on the command line."
msgstr "Ingen spildata fundet. Indstil datasti i Indstillinger eller brug --data på kommandolinjen."

msgid "You can also change the data path in Settings."
msgstr "Du kan også ændre datastien i Indstillinger."

msgid "Missing Liberation data"
msgstr "Manglende Liberation-data"
