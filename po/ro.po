#. Liberation building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Aceasta este %s. Nu primim vizitatori acum."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Bine ati venit la %s. Arhivele sunt disponibile publicului."

msgid "This is the %s police station. State your business."
msgstr "Aceasta este statia de politie %s. Cu ce va putem ajuta?"

msgid "City Records Office. How can we help?"
msgstr "Biroul de Evidenta. Cum va putem ajuta?"

msgid "%s. Come in and browse."
msgstr "%s. Intrati si priviti."

msgid "Welcome to %s! What'll it be?"
msgstr "Bine ati venit la %s! Ce doriti?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Bine ati venit la %s. Cum va putem ajuta astazi?"

msgid "%s. You shouldn't be here."
msgstr "%s. Nu ar trebui sa fiti aici."

msgid "You leave the building."
msgstr "Parasiti cladirea."

#. Liberation shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Bine ati venit la %s! Cu ce va pot ajuta?"

msgid "Goodbye!"
msgstr "La revedere!"

msgid "Buy/Sell"
msgstr "Cumpara/Vinde"

msgid "Any news?"
msgstr "Vreo noutate?"

msgid "Leave"
msgstr "Pleaca"

#. Liberation NPC dialogue
msgid "You leave."
msgstr "Plecati."

msgid "Trade"
msgstr "Comert"

msgid "Ask around"
msgstr "Intreaba"

#. Error messages
msgid "Failed to initialize renderer"
msgstr "Initializarea rendererului a esuat"

msgid "Missing game data"
msgstr "Date de joc lipsa"

msgid "No game data found. Please set the data path in Settings or use --data on the command line."
msgstr "Nu s-au gasit date de joc. Setati calea datelor in Setari sau folositi --data in linia de comanda."

msgid "You can also change the data path in Settings."
msgstr "Puteti schimba calea datelor si din Setari."

msgid "Missing Liberation data"
msgstr "Date Liberation lipsa"
