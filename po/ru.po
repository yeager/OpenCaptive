#. Liberation building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Это %s. Мы сейчас не принимаем посетителей."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Добро пожаловать в %s. Архивы доступны для публичного доступа."

msgid "This is the %s police station. State your business."
msgstr "Это полицейское управление %s. По какому делу?"

msgid "City Records Office. How can we help?"
msgstr "Городской архив. Чем можем помочь?"

msgid "This is a private residence. What do you want?"
msgstr "Это частное жильё. Что вам нужно?"

msgid "Welcome to %s. This area is restricted."
msgstr "Добро пожаловать в %s. Эта зона ограничена."

msgid "%s. Come in and browse."
msgstr "%s. Заходите и осмотритесь."

msgid "Welcome to %s! What'll it be?"
msgstr "Добро пожаловать в %s! Что желаете?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Добро пожаловать в %s. Чем можем помочь сегодня?"

msgid "%s. You shouldn't be here."
msgstr "%s. Вам не следует здесь быть."

msgid "Take a look at what I have."
msgstr "Посмотрите, что у меня есть."

msgid "I might have heard something. Check back later."
msgstr "Возможно, я что-то слышал. Загляните позже."

msgid "You leave the building."
msgstr "Вы покинули здание."

#. Liberation shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Добро пожаловать в %s! Чем могу помочь?"

msgid "Goodbye!"
msgstr "До свидания!"

msgid "Buy/Sell"
msgstr "Купить/Продать"

msgid "Any news?"
msgstr "Есть новости?"

msgid "Leave"
msgstr "Уйти"

#. Liberation NPC dialogue
msgid "You leave."
msgstr "Вы уходите."

msgid "Trade"
msgstr "Торговля"

msgid "Ask around"
msgstr "Расспросить"

