msgstr "Сканирование данных Liberation..."

msgid "ZIP archives found: %d"
msgstr "Найдено ZIP-архивов: %d"

msgid "VERIFICATION"
msgstr "ПРОВЕРКА"

msgid "Files identified by SHA-256 content hash, not filename."
msgstr "Файлы идентифицируются по хешу SHA-256 содержимого, а не по имени."

msgid "Nested ZIPs, ADF disk images, and ISO tracks are scanned."
msgstr "Вложенные ZIP, образы дисков ADF и дорожки ISO сканируются."

msgid "No filenames are trusted; only content determines identity."
msgstr "Имена файлов не используются; только содержимое определяет идентичность."

msgid "GAME DATA NOT FOUND"
msgstr "ДАННЫЕ ИГРЫ НЕ НАЙДЕНЫ"

msgid "OpenCaptive needs original game data files to run."
msgstr "Для запуска OpenCaptive необходимы оригинальные файлы данных игры."

msgid "Place your game data in the following folder:"
msgstr "Поместите данные игры в следующую папку:"

msgid "Supported formats: ZIP archives, ADF, ISO, raw files."
msgstr "Поддерживаемые форматы: ZIP-архивы, ADF, ISO, сырые файлы."

msgid "Files are identified by SHA-256 hash, not filename."
msgstr "Файлы идентифицируются по хешу SHA-256, а не по имени."

msgid "You can change the data path in Settings (S)."
msgstr "Путь к данным можно изменить в Настройках (S)."

msgid "PRESS ANY KEY TO CONTINUE"
msgstr "НАЖМИТЕ ЛЮБУЮ КЛАВИШУ ДЛЯ ПРОДОЛЖЕНИЯ"
