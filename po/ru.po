#. Liberation building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Eto %s. My seichas ne prinimaem posetitelei."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Dobro pozhalovat v %s. Arkhivy otkryty dlya publichnogo dostupa."

msgid "This is the %s police station. State your business."
msgstr "Eto politseiskii uchastok %s. Po kakomu delu?"

msgid "City Records Office. How can we help?"
msgstr "Gorodskoi arkhiv. Chem mozhem pomoch?"

msgid "%s. Come in and browse."
msgstr "%s. Zakhodite i osmatrivaites."

msgid "Welcome to %s! What'll it be?"
msgstr "Dobro pozhalovat v %s! Chto zhelaete?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Dobro pozhalovat v %s. Chem mozhem pomoch segodnya?"

msgid "%s. You shouldn't be here."
msgstr "%s. Vam ne sleduet zdes byt."

msgid "You leave the building."
msgstr "Vy pokinuli zdanie."

#. Liberation shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Dobro pozhalovat v %s! Chem mogu pomoch?"

msgid "Goodbye!"
msgstr "Do svidaniya!"

msgid "Buy/Sell"
msgstr "Kupit/Prodat"

msgid "Any news?"
msgstr "Est novosti?"

msgid "Leave"
msgstr "Uiti"

#. Liberation NPC dialogue
msgid "You leave."
msgstr "Vy ukhodite."

msgid "Trade"
msgstr "Torgovlya"

msgid "Ask around"
msgstr "Rassprosity"

#. Error messages
msgid "Failed to initialize renderer"
msgstr "Ne udalos initsializirovat renderer"

msgid "Missing game data"
msgstr "Dannye igry otsutstvuyut"

msgid "No game data found. Please set the data path in Settings or use --data on the command line."
msgstr "Dannye igry ne naideny. Ukazhite put k dannym v Nastroikakh ili ispolzuite --data v komandnoi stroke."

msgid "You can also change the data path in Settings."
msgstr "Vy takzhe mozhete izmenit put k dannym v Nastroikakh."

msgid "Missing Liberation data"
msgstr "Dannye Liberation otsutstvuyut"
