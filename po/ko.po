msgstr "시스템"

msgid "PRESS ANY KEY TO RETURN"
msgstr "아무 키나 눌러 돌아가기"

msgid "MOVEMENT"
msgstr "이동"

msgid "COMBAT & ITEMS"
msgstr "전투 및 아이템"

