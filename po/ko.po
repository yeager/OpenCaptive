msgstr "왼쪽 회전"

msgid "Turn right"
msgstr "오른쪽 회전"

msgid "Fire weapon"
msgstr "무기 발사"

msgid "Inventory"
msgstr "인벤토리"

msgid "Use item / Interact"
msgstr "아이템 사용 / 상호작용"

msgid "Cycle droids"
msgstr "드로이드 전환"

msgid "Cycle save slots"
msgstr "저장 슬롯 전환"

msgid "Save / Load game"
msgstr "저장 / 불러오기"

msgid "Minimap / City map"
msgstr "미니맵 / 도시 맵"

msgid "Help screen"
msgstr "도움말 화면"

msgid "Pause menu"
msgstr "일시정지 메뉴"

msgid "ESC: BACK"
msgstr "ESC: 뒤로"

msgid "DATA SCANNER"
msgstr "데이터 스캐너"

msgid "Scanning Captive hashes..."
msgstr "Captive 해시 스캔 중..."

msgid "Scanning Liberation data..."
msgstr "Liberation 데이터 스캔 중..."

msgid "ZIP archives found: %d"
msgstr "ZIP 아카이브 발견: %d"

msgid "VERIFICATION"
msgstr "검증"

msgid "Files identified by SHA-256 content hash, not filename."
msgstr "파일은 SHA-256 콘텐츠 해시로 식별됩니다 (파일 이름이 아님)."

msgid "Nested ZIPs, ADF disk images, and ISO tracks are scanned."
msgstr "중첩된 ZIP, ADF 디스크 이미지 및 ISO 트랙이 스캔됩니다."

msgid "No filenames are trusted; only content determines identity."
msgstr "파일 이름은 신뢰하지 않습니다. 콘텐츠만이 동일성을 결정합니다."

msgid "GAME DATA NOT FOUND"
msgstr "게임 데이터를 찾을 수 없음"

msgid "OpenCaptive needs original game data files to run."
msgstr "OpenCaptive를 실행하려면 원본 게임 데이터 파일이 필요합니다."

msgid "Place your game data in the following folder:"
msgstr "게임 데이터를 다음 폴더에 넣어 주세요:"

msgid "Supported formats: ZIP archives, ADF, ISO, raw files."
msgstr "지원 형식: ZIP 아카이브, ADF, ISO, 원시 파일."

msgid "Files are identified by SHA-256 hash, not filename."
msgstr "파일은 SHA-256 해시로 식별됩니다 (파일 이름이 아님)."

msgid "You can change the data path in Settings (S)."
msgstr "데이터 경로는 설정 (S)에서 변경할 수 있습니다."

msgid "PRESS ANY KEY TO CONTINUE"
msgstr "아무 키나 눌러 계속하기"
