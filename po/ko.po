#. Liberation building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "여기는 %s입니다. 지금은 방문객을 받지 않습니다."

msgid "Welcome to %s. The archives are available for public access."
msgstr "%s에 오신 것을 환영합니다. 기록물은 공개되어 있습니다."

msgid "This is the %s police station. State your business."
msgstr "여기는 %s 경찰서입니다. 무슨 일이십니까?"

msgid "City Records Office. How can we help?"
msgstr "시 기록관입니다. 어떻게 도와드릴까요?"

msgid "This is a private residence. What do you want?"
msgstr "여기는 개인 주택입니다. 무엇을 원하십니까?"

msgid "Welcome to %s. This area is restricted."
msgstr "%s에 오신 것을 환영합니다. 이 구역은 제한구역입니다."

msgid "%s. Come in and browse."
msgstr "%s입니다. 들어와서 둘러보세요."

msgid "Welcome to %s! What'll it be?"
msgstr "%s에 오신 것을 환영합니다! 무엇을 드릴까요?"

msgid "Welcome to %s. How can we help you today?"
msgstr "%s에 오신 것을 환영합니다. 오늘 어떻게 도와드릴까요?"

msgid "%s. You shouldn't be here."
msgstr "%s. 여기 있으면 안 됩니다."

msgid "Take a look at what I have."
msgstr "제가 가진 것을 보세요."

msgid "I might have heard something. Check back later."
msgstr "무언가 들은 것 같습니다. 나중에 다시 오세요."

msgid "You leave the building."
msgstr "건물을 떠납니다."

#. Liberation shop
msgid "Welcome to %s! What can I do for you?"
msgstr "%s에 오신 것을 환영합니다! 무엇을 도와드릴까요?"

msgid "Goodbye!"
msgstr "안녕히 가세요!"

msgid "Buy/Sell"
msgstr "매매"

msgid "Any news?"
msgstr "소식 있어요?"

msgid "Leave"
msgstr "떠나기"

#. Liberation NPC dialogue
msgid "You leave."
msgstr "떠납니다."

msgid "Trade"
msgstr "거래"

msgid "Ask around"
msgstr "물어보기"

#. Error messages
msgid "Failed to initialize renderer"
msgstr "렌더러 초기화 실패"

msgid "Missing game data"
msgstr "게임 데이터 없음"

msgid "No game data found. Please set the data path in Settings or use --data on the command line."
msgstr "게임 데이터를 찾을 수 없습니다. 설정에서 데이터 경로를 지정하거나 --data 명령을 사용하세요."

msgid "You can also change the data path in Settings."
msgstr "설정에서 데이터 경로를 변경할 수도 있습니다."

msgid "Missing Liberation data"
msgstr "Liberation 데이터 없음"

msgid "ABOUT"
msgstr "정보"

msgid "CONTROLS"
msgstr "조작법"

msgid "CONTINUE"
msgstr "계속"

msgid "ARROWS: SELECT  ENTER: START  D: SCAN DATA  F1: CONTROLS"
msgstr "화살표: 선택  ENTER: 시작  D: 데이터 스캔  F1: 조작법"

