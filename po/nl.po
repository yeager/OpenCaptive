#. Liberation building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Dit is %s. We ontvangen momenteel geen bezoekers."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Welkom bij %s. Het archief is openbaar toegankelijk."

msgid "This is the %s police station. State your business."
msgstr "Dit is het politiebureau van %s. Wat is uw doel?"

msgid "City Records Office. How can we help?"
msgstr "Gemeentelijk Archief. Waarmee kunnen we u helpen?"

msgid "%s. Come in and browse."
msgstr "%s. Kom binnen en kijk rond."

msgid "Welcome to %s! What'll it be?"
msgstr "Welkom bij %s! Wat mag het zijn?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Welkom bij %s. Waarmee kunnen we u vandaag helpen?"

msgid "%s. You shouldn't be here."
msgstr "%s. U hoort hier niet te zijn."

msgid "You leave the building."
msgstr "U verlaat het gebouw."

#. Liberation shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Welkom bij %s! Wat kan ik voor u doen?"

msgid "Goodbye!"
msgstr "Tot ziens!"

msgid "Buy/Sell"
msgstr "Kopen/Verkopen"

msgid "Any news?"
msgstr "Nog nieuws?"

msgid "Leave"
msgstr "Vertrekken"

#. Liberation NPC dialogue
msgid "You leave."
msgstr "U vertrekt."

msgid "Trade"
msgstr "Handel"

msgid "Ask around"
msgstr "Rondvragen"

#. Error messages
msgid "Failed to initialize renderer"
msgstr "Renderer initialisatie mislukt"

msgid "Missing game data"
msgstr "Spelgegevens ontbreken"

msgid "No game data found. Please set the data path in Settings or use --data on the command line."
msgstr "Geen spelgegevens gevonden. Stel het gegevenspad in via Instellingen of gebruik --data op de opdrachtregel."

msgid "You can also change the data path in Settings."
msgstr "U kunt het gegevenspad ook wijzigen in Instellingen."

msgid "Missing Liberation data"
msgstr "Liberation gegevens ontbreken"
