#. Liberation building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Questo e %s. Non accettiamo visitatori al momento."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Benvenuti a %s. Gli archivi sono disponibili al pubblico."

msgid "This is the %s police station. State your business."
msgstr "Questa e la stazione di polizia di %s. Dichiari il suo scopo."

msgid "City Records Office. How can we help?"
msgstr "Ufficio Anagrafe Comunale. Come possiamo aiutarla?"

msgid "%s. Come in and browse."
msgstr "%s. Entrate e guardate pure."

msgid "Welcome to %s! What'll it be?"
msgstr "Benvenuti da %s! Cosa desiderate?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Benvenuti a %s. Come possiamo aiutarvi oggi?"

msgid "%s. You shouldn't be here."
msgstr "%s. Non dovreste essere qui."

msgid "You leave the building."
msgstr "Lasciate l'edificio."

#. Liberation shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Benvenuti da %s! Cosa posso fare per voi?"

msgid "Goodbye!"
msgstr "Arrivederci!"

msgid "Buy/Sell"
msgstr "Compra/Vendi"

msgid "Any news?"
msgstr "Qualche novita?"

msgid "Leave"
msgstr "Esci"

#. Liberation NPC dialogue
msgid "You leave."
msgstr "Ve ne andate."

msgid "Trade"
msgstr "Commercio"

msgid "Ask around"
msgstr "Chiedi in giro"

#. Error messages
msgid "Failed to initialize renderer"
msgstr "Inizializzazione del renderer fallita"

msgid "Missing game data"
msgstr "Dati di gioco mancanti"

msgid "No game data found. Please set the data path in Settings or use --data on the command line."
msgstr "Nessun dato di gioco trovato. Impostare il percorso dati nelle Impostazioni o usare --data nella riga di comando."

msgid "You can also change the data path in Settings."
msgstr "E possibile cambiare il percorso dati nelle Impostazioni."

msgid "Missing Liberation data"
msgstr "Dati Liberation mancanti"
