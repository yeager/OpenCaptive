msgstr "Liberation adatok keresése..."

msgid "ZIP archives found: %d"
msgstr "Talált ZIP archívumok: %d"

msgid "VERIFICATION"
msgstr "ELLENŐRZÉS"

msgid "Files identified by SHA-256 content hash, not filename."
msgstr "A fájlok SHA-256 tartalomhash alapján azonosítottak, nem fájlnév alapján."

msgid "Nested ZIPs, ADF disk images, and ISO tracks are scanned."
msgstr "Beágyazott ZIP-ek, ADF lemezkép és ISO sávok keresése."

msgid "No filenames are trusted; only content determines identity."
msgstr "Egyetlen fájlnévben sem bízunk; csak a tartalom határozza meg az azonosságot."

msgid "GAME DATA NOT FOUND"
msgstr "JÁTÉKADATOK NEM TALÁLHATÓK"

msgid "OpenCaptive needs original game data files to run."
msgstr "Az OpenCaptive-nak szüksége van az eredeti játékadatfájlokra a futtatáshoz."

msgid "Place your game data in the following folder:"
msgstr "Helyezze a játékadatokat a következő mappába:"

msgid "Supported formats: ZIP archives, ADF, ISO, raw files."
msgstr "Támogatott formátumok: ZIP archívumok, ADF, ISO, nyers fájlok."

msgid "Files are identified by SHA-256 hash, not filename."
msgstr "A fájlok SHA-256 hash alapján azonosítottak, nem fájlnév alapján."

msgid "You can change the data path in Settings (S)."
msgstr "Az adatok útvonalát a Beállításokban (S) módosíthatja."

msgid "PRESS ANY KEY TO CONTINUE"
msgstr "NYOMJON EGY BILLENTYŰT A FOLYTATÁSHOZ"
