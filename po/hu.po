#. Liberation building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Ez %s. Jelenleg nem fogadunk latogatokat."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Udvozoljuk a %s-ben. Az archivum nyilvanos hozzaferesre elerheto."

msgid "This is the %s police station. State your business."
msgstr "Ez a %s rendorkapitanysag. Mi jaratban?"

msgid "City Records Office. How can we help?"
msgstr "Varosi Nyilvantartasi Hivatal. Miben segithetunk?"

msgid "%s. Come in and browse."
msgstr "%s. Jonnek be es nezzek korul."

msgid "Welcome to %s! What'll it be?"
msgstr "Udvozoljuk a %s-ben! Mit keresnek?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Udvozoljuk a %s-ben. Miben segithetunk ma?"

msgid "%s. You shouldn't be here."
msgstr "%s. Nem kellene itt lennie."

msgid "You leave the building."
msgstr "Elhagyja az epuletet."

#. Liberation shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Udvozoljuk a %s-ben! Miben segithetek?"

msgid "Goodbye!"
msgstr "Viszontlatasra!"

msgid "Buy/Sell"
msgstr "Vetel/Eladas"

msgid "Any news?"
msgstr "Van valami ujsag?"

msgid "Leave"
msgstr "Tavozas"

#. Liberation NPC dialogue
msgid "You leave."
msgstr "Tavozik."

msgid "Trade"
msgstr "Kereskedelem"

msgid "Ask around"
msgstr "Kerdezoeskodes"

#. Error messages
msgid "Failed to initialize renderer"
msgstr "A megjelenieto inicializalasa sikertelen"

msgid "Missing game data"
msgstr "Hianyzik a jatekadatok"

msgid "No game data found. Please set the data path in Settings or use --data on the command line."
msgstr "Nem talalhato jatekadat. Allitsa be az eleresi utat a Beallitasokban vagy hasznaljon --data parameterrel a parancssorban."

msgid "You can also change the data path in Settings."
msgstr "Az eleresi utat a Beallitasokban is megvaltoztathatja."

msgid "Missing Liberation data"
msgstr "Hianyzik a Liberation adatok"
