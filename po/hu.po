#. Liberation building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Ez %s. Jelenleg nem fogadunk látogatókat."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Üdvözöljük %s. Az archívum nyilvános hozzáférésű."

msgid "This is the %s police station. State your business."
msgstr "Ez a %s rendőrkapitányság. Mi járatban?"

msgid "City Records Office. How can we help?"
msgstr "Városi nyilvántartási hivatal. Miben segíthetünk?"

msgid "This is a private residence. What do you want?"
msgstr "Ez egy magánlakás. Mit akar?"

msgid "Welcome to %s. This area is restricted."
msgstr "Üdvözöljük %s. Ez a terület korlátozott."

msgid "%s. Come in and browse."
msgstr "%s. Jöjjön be és nézzen körül."

msgid "Welcome to %s! What'll it be?"
msgstr "Üdvözöljük %s! Mit parancsol?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Üdvözöljük %s. Miben segíthetünk ma?"

msgid "%s. You shouldn't be here."
msgstr "%s. Nem kellene itt lennie."

msgid "Take a look at what I have."
msgstr "Nézze meg, mim van."

msgid "I might have heard something. Check back later."
msgstr "Lehet, hogy hallottam valamit. Jöjjön vissza később."

msgid "You leave the building."
msgstr "Elhagyja az épületet."

#. Liberation shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Üdvözöljük %s! Miben segíthetek?"

msgid "Goodbye!"
msgstr "Viszontlátásra!"

msgid "Buy/Sell"
msgstr "Vétel/Eladás"

msgid "Any news?"
msgstr "Van valami újság?"

msgid "Leave"
msgstr "Távozás"

#. Liberation NPC dialogue
msgid "You leave."
msgstr "Távozik."

msgid "Trade"
msgstr "Kereskedés"

msgid "Ask around"
msgstr "Kérdezősködés"

#. Error messages
msgid "Failed to initialize renderer"
msgstr "A megjelenítő inicializálása sikertelen"

msgid "Missing game data"
msgstr "Hiányzik a játékadatok"

msgid "No game data found. Please set the data path in Settings or use --data on the command line."
msgstr "Nem található játékadat. Állítsa be az adatutat a Beállításokban vagy használja a --data kapcsolót."

msgid "You can also change the data path in Settings."
msgstr "Az adatutat a Beállításokban is megváltoztathatja."

msgid "Missing Liberation data"
msgstr "Hiányzik a Liberation adat"
