#. Liberation building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Aqui é %s. Não estamos recebendo visitantes agora."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Bem-vindo a %s. Os arquivos estão disponíveis para acesso público."

msgid "This is the %s police station. State your business."
msgstr "Esta é a delegacia de %s. Qual é o seu assunto?"

msgid "City Records Office. How can we help?"
msgstr "Cartório Municipal. Como podemos ajudar?"

msgid "This is a private residence. What do you want?"
msgstr "Esta é uma residência particular. O que você quer?"

msgid "Welcome to %s. This area is restricted."
msgstr "Bem-vindo a %s. Esta área é restrita."

msgid "%s. Come in and browse."
msgstr "%s. Entre e dê uma olhada."

msgid "Welcome to %s! What'll it be?"
msgstr "Bem-vindo a %s! O que vai ser?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Bem-vindo a %s. Como podemos ajudá-lo hoje?"

msgid "%s. You shouldn't be here."
msgstr "%s. Você não deveria estar aqui."

msgid "Take a look at what I have."
msgstr "Dê uma olhada no que eu tenho."

msgid "I might have heard something. Check back later."
msgstr "Talvez eu tenha ouvido algo. Volte mais tarde."

msgid "You leave the building."
msgstr "Você sai do prédio."

#. Liberation shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Bem-vindo a %s! O que posso fazer por você?"

msgid "Goodbye!"
msgstr "Adeus!"

msgid "Buy/Sell"
msgstr "Comprar/Vender"

msgid "Any news?"
msgstr "Alguma novidade?"

msgid "Leave"
msgstr "Sair"

#. Liberation NPC dialogue
msgid "You leave."
msgstr "Você sai."

msgid "Trade"
msgstr "Comércio"

msgid "Ask around"
msgstr "Perguntar por aí"

