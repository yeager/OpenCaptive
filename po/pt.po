#. Liberation building interactions
msgid "This is %s. We're not taking visitors right now."
msgstr "Aqui e %s. Nao estamos recebendo visitantes agora."

msgid "Welcome to %s. The archives are available for public access."
msgstr "Bem-vindo a %s. Os arquivos estao disponiveis ao publico."

msgid "This is the %s police station. State your business."
msgstr "Esta e a delegacia de %s. Qual e o seu assunto?"

msgid "City Records Office. How can we help?"
msgstr "Cartorio Municipal. Como podemos ajudar?"

msgid "%s. Come in and browse."
msgstr "%s. Entre e de uma olhada."

msgid "Welcome to %s! What'll it be?"
msgstr "Bem-vindo a %s! O que vai ser?"

msgid "Welcome to %s. How can we help you today?"
msgstr "Bem-vindo a %s. Como podemos ajuda-lo hoje?"

msgid "%s. You shouldn't be here."
msgstr "%s. Voce nao deveria estar aqui."

msgid "You leave the building."
msgstr "Voce sai do predio."

#. Liberation shop
msgid "Welcome to %s! What can I do for you?"
msgstr "Bem-vindo a %s! O que posso fazer por voce?"

msgid "Goodbye!"
msgstr "Adeus!"

msgid "Buy/Sell"
msgstr "Comprar/Vender"

msgid "Any news?"
msgstr "Alguma novidade?"

msgid "Leave"
msgstr "Sair"

#. Liberation NPC dialogue
msgid "You leave."
msgstr "Voce sai."

msgid "Trade"
msgstr "Comercio"

msgid "Ask around"
msgstr "Perguntar"

#. Error messages
msgid "Failed to initialize renderer"
msgstr "Falha ao inicializar o renderizador"

msgid "Missing game data"
msgstr "Dados do jogo ausentes"

msgid "No game data found. Please set the data path in Settings or use --data on the command line."
msgstr "Dados do jogo nao encontrados. Defina o caminho dos dados em Configuracoes ou use --data na linha de comando."

msgid "You can also change the data path in Settings."
msgstr "Voce tambem pode alterar o caminho dos dados em Configuracoes."

msgid "Missing Liberation data"
msgstr "Dados de Liberation ausentes"
