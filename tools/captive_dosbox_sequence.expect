#!/usr/bin/expect -f

# Authentic CAPPO input sequence probe. Every byte is delivered through the
# DOSBox-X's emulated AT keyboard controller and IRQ1 path; this harness never
# writes CAPPO's private input matrix, game files, or a compatibility state.
# The optional post-input timer
# count is only a pacing control for observing the original runtime surface.

# A complete DOSBox-X VRT observation can take longer than the normal input
# prompt on a busy host.  This is only an observation timeout; it does not
# advance CAPPO state or synthesize a transition.
set timeout 120
if {$argc < 2} {
    puts stderr [format "usage: %s DATA_DIR SCAN_HEX-list POST_INTRO_TICKS OUTPUT_DIR POST_SCAN_TICKS (FIFO_PATH optional)" $argv0]
    exit 2
}
set data_dir [lindex $argv 0]
set sequence [split [lindex $argv 1] ","]
set post_intro_ticks [expr {$argc > 2 ? [lindex $argv 2] : 240}]
set output_dir [expr {$argc > 3 ? [file normalize [lindex $argv 3]] : [pwd]}]
set post_scan_ticks [expr {$argc > 4 ? [lindex $argv 4] : 8}]
set fifo_path [expr {$argc > 5 ? [file normalize [lindex $argv 5]] : ""}]
set trace_status [expr {[info exists ::env(CAPPO_TRACE_STATUS)] && $::env(CAPPO_TRACE_STATUS) ne ""}]
set trace_dispatch [expr {[info exists ::env(CAPPO_TRACE_DISPATCH)] && $::env(CAPPO_TRACE_DISPATCH) ne ""}]
set trace_status_runtime [expr {[info exists ::env(CAPPO_TRACE_STATUS_RUNTIME)] && $::env(CAPPO_TRACE_STATUS_RUNTIME) ne ""}]
set orbit_input_consumed 0
set script_dir [file dirname [file normalize $argv0]]
set profile [file join $script_dir dosbox-x-captive.conf]
if {![file isdirectory $data_dir] || ![file exists $profile]} {
    puts stderr "missing Captive data directory or DOSBox-X profile"
    exit 2
}
foreach scan $sequence {
    if {$scan eq "-"} { continue }
    if {![regexp {^[0-9A-Fa-f]{2}$} $scan]} {
        puts stderr "invalid scan byte: $scan"
        exit 2
    }
}
if {$post_intro_ticks < 1 || $post_intro_ticks > 2000} {
    puts stderr "POST_INTRO_TICKS must be between 1 and 2000"
    exit 2
}
if {$post_scan_ticks < 1 || $post_scan_ticks > 2000} {
    puts stderr "POST_SCAN_TICKS must be between 1 and 2000"
    exit 2
}
if {![file isdirectory $output_dir]} {
    puts stderr "OUTPUT_DIR does not exist: $output_dir"
    exit 2
}
if {$fifo_path ne "" && ![file exists $fifo_path]} {
    puts stderr "FIFO_PATH does not exist: $fifo_path"
    exit 2
}
# DOSBox-X writes MEMDUMPBIN relative to the host working directory.  Make
# that location explicit so a successful probe cannot silently overwrite a
# stale dump elsewhere in the repository.
cd $output_dir

proc resume_emulation {} { send "\033\[15~" }
set timer_breakpoint_installed 0
if {$trace_status_runtime} {
    send "BP 0824:43B0\r"
}
set cappo_dispatch_hit 0
proc wait_for_timer_break {} {
    global cappo_dispatch_hit
    expect {
        -re {07E4:6A33|0824:6633} { set cappo_dispatch_hit 1; exp_continue }
        -re {0824:43B0} { puts stderr "CAPPO status-message helper reached at 0824:43B0"; exp_continue }
        -re {I->} {}
        timeout { puts stderr "DOSBox-X did not reach the timer breakpoint"; exit 1 }
        eof { exit 1 }
    }
}
proc advance_timer_ticks {count} {
    global timer_breakpoint_installed
    if {!$timer_breakpoint_installed} {
        send "BPINT 08\r"
        set timer_breakpoint_installed 1
    }
    for {set i 0} {$i < $count} {incr i} {
        resume_emulation
        wait_for_timer_break
    }
}
proc integration_write32 {index value} {
    # DOSBox-X integration device: index port 28h, data port 29h.  The
    # writes are emulated hardware I/O, not writes to CAPPO memory.
    for {set shift 0} {$shift < 32} {incr shift 8} {
        send [format "OUTB 28 %02X\r" [expr {($index >> $shift) & 0xff}]]
    }
    for {set shift 0} {$shift < 32} {incr shift 8} {
        send [format "OUTB 29 %02X\r" [expr {($value >> $shift) & 0xff}]]
    }
}
proc inject_mouse_dx {delta} {
    if {$delta < -127 || $delta > 127} { return }
    # DOSBox-X bios.cpp decodes the full high word from bits 16..31:
    # Mouse_CursorMoved(((reg >> 16) / 256) - 1, ...). A positive integer
    # delta therefore occupies bits 24..31. The protocol has no signed
    # representation below -1, so emit repeated -1 steps for negative
    # motion. These remain real DOSBox-X mouse events, not game-state writes.
    if {$delta < -1} {
        for {set i 0} {$i > $delta} {incr i -1} {
            integration_write32 0x00804200 0x00000900
        }
    } else {
        set encoded [expr {($delta + 1) << 24 | 0x0900}]
        integration_write32 0x00804200 $encoded
    }
}
proc inject_mouse_dy {delta} {
    if {$delta < -127 || $delta > 127} { return }
    if {$delta < -1} {
        for {set i 0} {$i > $delta} {incr i -1} {
            integration_write32 0x00804200 0x00000A00
        }
    } else {
        set encoded [expr {($delta + 1) << 24 | 0x0A00}]
        integration_write32 0x00804200 $encoded
    }
}
proc inject_mouse_button {pressed} {
    set value [expr {$pressed ? 0x880 : 0x800}]
    integration_write32 0x00804200 $value
}

proc inject_keyboard_scan {scan} {
    # AT keyboard controller command D2 places the following byte in the
    # emulated keyboard output buffer and raises IRQ1. This is hardware input,
    # not a write to CAPPO's private queue or game state.
    send "OUTB 64 D2\r"
    send [format "OUTB 60 %02X\r" $scan]
}

spawn env TERM=xterm-256color dosbox-x -break-start -conf $profile -set debuggerrun=debugger \
    -c "mount c $data_dir" -c "c:" -c "CAPTIVE.BAT 1"
expect {
    -re {I->} {}
    timeout { puts stderr "DOSBox-X debugger did not start"; exit 1 }
}

# CAPPO's unpacked dispatcher is at file offset 0x6A33. The authentic
# Mission 0001 dump places the unpacked image at linear 0x7E40, i.e. segment
# 07E4. This breakpoint is the handoff proof; a FILEPLAY-only session must
# fail closed even if its memory contains CAPPO message strings.
send "BP 0824:6633\r"

# CAPPO's unpacked status-message helper is 0x47B0; the active 0824 runtime
# bank is relocated by -0x400, so its live address is 0824:43B0. This is an
# opt-in disassembly probe only and is never installed in normal verification.
if {$trace_status} {
    send "BP 0824:43B0\r"
}
if {$trace_status_runtime} {
    # CAPPO's unpacked status-message helper (0x47B0) is relocated to the
    # active Mission 0001 bank at 0824:43B0. Keep it as a runtime observation
    # only; the probe never writes the status or advances a phase locally.
    send "BP 0824:43B0\r"
}

# Original INTRO choices: 1, 4, 3, 3. Deliver them through the emulated
# AT keyboard and IRQ1 handler; do not write BIOS keyboard memory.
advance_timer_ticks 120
foreach key {1 enter 4 enter 3 enter 3 enter} {
    switch -- $key {
        1 { set scan_code 0x02 }
        3 { set scan_code 0x04 }
        4 { set scan_code 0x05 }
        enter { set scan_code 0x1c }
    }
    inject_keyboard_scan $scan_code
    advance_timer_ticks 24
    set break_scan [expr {0x80 | $scan_code}]
    inject_keyboard_scan $break_scan
    advance_timer_ticks 24
}

# Diagnostic only: record FILEPLAY's active code segment before attempting the
# handoff. The value is read from DOSBox-X registers; no memory is modified.
send "EV CS\r"

# FILEPLAY consumes the original spacebar from the emulated AT controller.
inject_keyboard_scan 0x39
advance_timer_ticks 120

# INTRO/FILEPLAY hands control to CAPPO on the original space-bar action.
# CAPPO's first screen is then continued by its documented DEL/left-mouse
# action.  Do not substitute another keyboard key: that leaves the original
# runtime in its start-screen phase and consumes the first navigation scan.
for {set intro_step 0} {$intro_step < 1} {incr intro_step} {
    inject_keyboard_scan 0x53
    advance_timer_ticks $post_intro_ticks
    inject_keyboard_scan 0xD3
    advance_timer_ticks $post_intro_ticks
}

# The dispatcher breakpoint is only a CAPPO handoff proof. Leaving it active
# would stop the original dispatcher before the timer IRQ can run its
# flight/arrival update, making later WAIT commands look like a frozen route.
# Clear every diagnostic breakpoint after handoff.  The intro pacing helper
# installs an INT 08 breakpoint as well as the CAPPO dispatcher breakpoint;
# leaving INT 08 active makes VRT stop before CAPPO's flight/arrival update.
# VRT itself is the only observation boundary after this point.
send "BPDEL *\r"
expect {
    -re {Breakpoints deleted\.|Breakpoint deletion success|No breakpoints} {}
    timeout { puts stderr "DOSBox-X did not clear diagnostic breakpoints"; exit 1 }
    eof { exit 1 }
}
set timer_breakpoint_installed 0

# After handoff, run complete emulator frames.  BPINT 08 stops at the entry
# to the timer ISR, before CAPPO can execute its flight/arrival update. VRT
# resumes the original machine through a complete vertical-retrace interval
# and then returns to the debugger for an observation; no game state is
# written by this helper.
proc advance_runtime_ticks {count} {
    for {set i 0} {$i < $count} {incr i} {
        send "VRT\r"
        expect {
            -re {I->} {}
            timeout { puts stderr "DOSBox-X did not reach the next vertical retrace"; exit 1 }
            eof { exit 1 }
        }
    }
}

proc trace_dispatch_state {} {
    # DOSBox-X accepts a register list in one EV command.  Capturing the
    # complete state at the dispatcher prompt avoids the misleading sequence
    # of unrelated single-register prompts that the old probe produced.
    send "EV CS IP DS AX SI DI\r"
    expect {
        -re {LOG: EV of 'CS IP DS AX SI DI' is:\s*\r?\n([^\r\n]+)} {
            puts stderr "CAPPO dispatcher registers: $expect_out(1,string)"
        }
        timeout { puts stderr "DOSBox-X did not return the dispatcher registers"; exit 1 }
        eof { exit 1 }
    }
}

# CAPPO's original IRQ1 handler reads port 60h, builds the keyboard matrix at
# DS:02DC/03DC, and then the dispatcher consumes that matrix. The debugger's
# keyboard-controller D2 command injects the same hardware byte; pairing make
# and break scans preserves real key-up behavior.
foreach scan $sequence {
    if {$scan eq "-"} { continue }
    scan $scan %x scan_value
    inject_keyboard_scan $scan_value
    advance_runtime_ticks $post_scan_ticks
    set break_scan [expr {0x80 | $scan_value}]
    inject_keyboard_scan $break_scan
    advance_runtime_ticks $post_scan_ticks
}

proc dump_cappo_memory {output_dir} {
    # MEMDUMPBIN reuses the same host path. Remove the previous dump first so
    # callers cannot mistake a still-complete old 1 MiB file for the frame
    # produced by the command that immediately preceded this request.
    set dump_path [file join $output_dir MEMDUMP.BIN]
    if {[file exists $dump_path]} {
        file delete -force $dump_path
    }
    send "MEMDUMPBIN 0 0 100000\r"
    expect {
        -re {Memory dump(?: binary)? success} {}
        timeout { puts stderr "DOSBox-X did not write MEMDUMP.BIN"; exit 1 }
        eof { exit 1 }
    }
    if {![file exists $dump_path] || [file size $dump_path] != 1048576} {
        puts stderr "DOSBox-X did not produce a complete 1 MiB dump at $dump_path"
        exit 1
    }
    return $dump_path
}

set dump_path [dump_cappo_memory $output_dir]
if {!$cappo_dispatch_hit} {
    puts stderr "CAPPO dispatcher 07E4:6A33 was never reached; refusing FILEPLAY-only dump"
    exit 1
}
if {$fifo_path ne ""} {
    # A FIFO command is a raw XT make scan, not a symbolic game action. The
    # emulated AT controller and CAPPO IRQ1 handler still own the input state.
    set fifo [open $fifo_path r+]
    fconfigure $fifo -translation lf -encoding ascii -buffering line -blocking 1
    puts stderr "CAPPO live FIFO ready: $fifo_path"
    while {[gets $fifo command] >= 0} {
        set command [string trim $command]
    if {$command eq "quit"} { break }
        if {[regexp {^WAIT:([0-9]+)$} $command -> wait_ticks]} {
            if {$wait_ticks < 1 || $wait_ticks > 2000} {
                puts stderr "WAIT tick count must be between 1 and 2000"
                continue
            }
            # Diagnostic pacing only: let the original CAPPO timer run without
            # injecting a keyboard event. This is essential for distinguishing
            # FLIGHT PATH SET from CAPPO's later ARRIVED AT DESTINATION state.
            advance_runtime_ticks $wait_ticks
            set dump_path [dump_cappo_memory $output_dir]
            puts stderr "CAPPO live timer advanced: $wait_ticks"
            continue
        }
        if {[regexp {^MOUSE_DX:([-+]?[0-9]+)$} $command -> delta]} {
            inject_mouse_dx $delta
            advance_runtime_ticks $post_scan_ticks
            set dump_path [dump_cappo_memory $output_dir]
            puts stderr "CAPPO live mouse dx delivered: $delta"
            continue
        }
        if {[regexp {^MOUSE_DY:([-+]?[0-9]+)$} $command -> delta]} {
            inject_mouse_dy $delta
            advance_runtime_ticks $post_scan_ticks
            set dump_path [dump_cappo_memory $output_dir]
            puts stderr "CAPPO live mouse dy delivered: $delta"
            continue
        }
        if {$command eq "MOUSE_DOWN" || $command eq "MOUSE_UP"} {
            inject_mouse_button [expr {$command eq "MOUSE_DOWN"}]
            advance_runtime_ticks $post_scan_ticks
            set dump_path [dump_cappo_memory $output_dir]
            puts stderr "CAPPO live mouse button delivered: $command"
            continue
        }
        if {[regexp {^HWSCAN:([0-9A-Fa-f]{2})$} $command -> hwscan]} {
            scan $hwscan %x hw_value
            inject_keyboard_scan $hw_value
            advance_runtime_ticks $post_scan_ticks
            set dump_path [dump_cappo_memory $output_dir]
            puts stderr "CAPPO hardware keyboard scan delivered: $hwscan"
            continue
        }
        if {![regexp {^[0-9A-Fa-f]{2}$} $command]} {
            puts stderr "invalid live CAPPO scan byte: $command"
            continue
        }
        if {$trace_dispatch} {
            send "BP 0824:6633\r"
        }
        scan $command %x command_value
        inject_keyboard_scan $command_value
        advance_runtime_ticks $post_scan_ticks
        if {$trace_dispatch} {
            trace_dispatch_state
            send "BPDEL *\r"
            expect {
                -re {Breakpoints deleted\.|Breakpoint deletion success|No breakpoints} {}
                timeout { puts stderr "DOSBox-X did not clear dispatch trace breakpoint"; exit 1 }
                eof { exit 1 }
            }
        }
        set break_scan [expr {0x80 | $command_value}]
        inject_keyboard_scan $break_scan
        advance_runtime_ticks $post_scan_ticks
        set dump_path [dump_cappo_memory $output_dir]
        puts stderr "CAPPO live scan delivered: $command"
    }
    close $fifo
}
# Do not search the one-megabyte image for printable messages here. CAPPO's
# message table is resident even when a message is not being displayed, so a
# strings hit cannot prove the active phase. The harness has already proven the
# original INTRO/FILEPLAY -> CAPPO handoff and the dump is complete; pixel-level
# verification is performed by verify_captive_dos_dump.sh.
puts stderr "CAPPO sequence delivered: [join $sequence {, }]"
puts stderr "Authentic CAPPO dump verified at $dump_path"
interact
