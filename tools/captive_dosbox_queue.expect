#!/usr/bin/expect -f

# Emulator-only CAPPO input probe. The harness runs the supplied original
# CAPTIVE.BAT chain, answers the original INTRO prompts, and injects one raw
# XT make/break pair through DOSBox-X's emulated AT keyboard controller.
# It never creates or modifies Captive game data.

set timeout 30
if {$argc < 1} {
    puts stderr [format "usage: %s DATA_DIR SCAN_HEX" $argv0]
    exit 2
}

set data_dir [lindex $argv 0]
set scan [expr {$argc > 1 ? [lindex $argv 1] : "47"}]
if {![regexp {^[0-9A-Fa-f]{2}$} $scan]} {
    puts stderr "SCAN_HEX must be one byte in hexadecimal"
    exit 2
}
set script_dir [file dirname [file normalize $argv0]]
set profile [file join $script_dir dosbox-x-captive.conf]
if {![file isdirectory $data_dir] || ![file exists $profile]} {
    puts stderr "missing Captive data directory or DOSBox-X profile"
    exit 2
}

proc resume_emulation {} {
    send "\033\[15~"
}

proc wait_for_timer_break {} {
    expect {
        # The debugger prompt is emitted after the active INT 08 breakpoint.
        # Do not match FEA5/FEAA: those are ordinary instruction addresses
        # and can appear in debugger listings before the breakpoint fires.
        -re {I->} {}
        timeout {
            puts stderr "DOSBox-X did not reach the timer breakpoint"
            exit 1
        }
        eof { exit 1 }
    }
}

proc wait_for_debug_message {pattern description} {
    expect {
        -re $pattern {}
        timeout {
            puts stderr "DOSBox-X did not report $description"
            exit 1
        }
        eof { exit 1 }
    }
}

proc inject_keyboard_scan {scan} {
    # 8042 command D2 places a byte in the emulated keyboard output buffer
    # and raises the original IRQ1 handler. This does not touch CAPPO memory.
    send "OUTB 64 D2\r"
    send [format "OUTB 60 %02X\r" $scan]
}

spawn env TERM=xterm-256color dosbox-x -break-start -conf $profile -set debuggerrun=debugger \
    -c "mount c $data_dir" -c "c:" -c "CAPTIVE.BAT 1"
expect {
    -re {I->} {}
    timeout {
        puts stderr "DOSBox-X debugger did not start"
        exit 1
    }
}

# Feed the original INTRO choices through DOSBox-X's emulated AT keyboard and
# the original IRQ1 handler; no BIOS keyboard memory is written.
send "BPINT 08\r"
resume_emulation
wait_for_timer_break
set choices {1 enter 4 enter 3 enter 3 enter}
foreach key $choices {
    send "BPDEL 00\r"
    switch -- $key {
        1     { set scan_code 0x02 }
        3     { set scan_code 0x04 }
        4     { set scan_code 0x05 }
        enter { set scan_code 0x1c }
        default { puts stderr "unsupported input token: $key"; exit 2 }
    }
    inject_keyboard_scan $scan_code
    send "BPINT 08\r"
    resume_emulation
    wait_for_timer_break
    set break_scan [expr {0x80 | $scan_code}]
    inject_keyboard_scan $break_scan
    send "BPINT 08\r"
    resume_emulation
    wait_for_timer_break
}

# CAPPO's verified Mission 0001 runtime handler is at 0824:065c. It reads the
# AT controller byte from port 60h, translates it through CAPPO's original
# keyboard table, and updates the runtime matrix.
send "BPDEL 00\r"
scan $scan %x scan_value
inject_keyboard_scan $scan_value
send "BPINT 08\r"
resume_emulation
wait_for_timer_break
set break_scan [expr {0x80 | $scan_value}]
inject_keyboard_scan $break_scan
send "BPINT 08\r"
resume_emulation
wait_for_timer_break
send "BPDEL 00\r"
wait_for_debug_message {Breakpoint deletion success} "breakpoint deletion"
# Keep a textual post-injection trace in DOSBox-X's documented dump file.  The
# queue is consumed by CAPPO's keyboard IRQ1 handler, not by the timer IRQ08
# breakpoint used to make this probe deterministic.
send "MEMDUMP 0824 004E 8\r"
wait_for_debug_message {Memory dump success} "memory dump completion"
puts stderr "CAPPO IRQ1 hardware probe delivered raw make/break scan byte 0x$scan"
interact
