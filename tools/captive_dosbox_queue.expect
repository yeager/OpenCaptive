#!/usr/bin/expect -f

# Emulator-only CAPPO input probe. The harness runs the supplied original
# CAPTIVE.BAT chain, answers the original INTRO prompts, and injects one raw
# XT scan byte into CAPPO's relocated IRQ1 queue while DOSBox-X is paused.
# It never creates or modifies Captive game data.

set timeout 30
if {$argc < 1} {
    puts stderr "usage: $argv0 DATA_DIR [SCAN_HEX]"
    exit 2
}

set data_dir [lindex $argv 0]
set scan [expr {$argc > 1 ? [lindex $argv 1] : "47"}]
if {![regexp {^[0-9A-Fa-f]{2}$} $scan]} {
    puts stderr "SCAN_HEX must be one byte in hexadecimal"
    exit 2
}
set script_dir [file dirname [file normalize $argv0]]
set profile [file join $script_dir dosbox-x-captive.conf]
if {![file isdirectory $data_dir] || ![file exists $profile]} {
    puts stderr "missing Captive data directory or DOSBox-X profile"
    exit 2
}

proc resume_emulation {} {
    send "\033\[15~"
}

proc wait_for_timer_break {} {
    expect {
        # The debugger prompt is emitted after the active INT 08 breakpoint.
        # Do not match FEA5/FEAA: those are ordinary instruction addresses
        # and can appear in debugger listings before the breakpoint fires.
        -re {I->} {}
        timeout {
            puts stderr "DOSBox-X did not reach the timer breakpoint"
            exit 1
        }
        eof { exit 1 }
    }
}

proc wait_for_debug_message {pattern description} {
    expect {
        -re $pattern {}
        timeout {
            puts stderr "DOSBox-X did not report $description"
            exit 1
        }
        eof { exit 1 }
    }
}

spawn env TERM=xterm-256color dosbox-x -break-start -conf $profile \
    -c "mount c $data_dir" -c "c:" -c "CAPTIVE.BAT 1"
expect {
    -re {I->} {}
    timeout {
        puts stderr "DOSBox-X debugger did not start"
        exit 1
    }
}

# Feed the original INTRO choices through the emulated BIOS keyboard ring.
send "BPINT 08\r"
resume_emulation
wait_for_timer_break
send "SM 0040 001A 1E 00\r"
set tail 0x1e
set choices {1 enter 4 enter 3 enter 3 enter}
foreach key $choices {
    send "BPDEL 00\r"
    switch -- $key {
        1     { set ascii 0x31; set scan_code 0x02 }
        3     { set ascii 0x33; set scan_code 0x04 }
        4     { set ascii 0x34; set scan_code 0x05 }
        enter { set ascii 0x0d; set scan_code 0x1c }
        default { puts stderr "unsupported input token: $key"; exit 2 }
    }
    send [format "SM 0040 %04X %02X %02X\r" $tail $ascii $scan_code]
    incr tail 2
    if {$tail >= 0x40} { set tail 0x1e }
    send [format "SM 0040 001C %02X 00\r" $tail]
    send "BPINT 08\r"
    resume_emulation
    wait_for_timer_break
}

# CAPPO's verified Mission 0001 runtime segment is 0824.  The handler at
# 0824:065c consumes CS:004e count, CS:004f ring index and CS:0050..0057.
# Set one queued byte at ring slot zero: count=1, index=1, data=SCAN_HEX.
send "BPDEL 00\r"
send "SM 0824 004E 01\r"
send "SM 0824 004F 01\r"
send [format "SM 0824 0050 %s\r" $scan]
send "BPINT 08\r"
resume_emulation
wait_for_timer_break
send "BPDEL 00\r"
wait_for_debug_message {Breakpoint deletion success} "breakpoint deletion"
# Keep a textual post-injection trace in DOSBox-X's documented dump file.  The
# queue is consumed by CAPPO's keyboard IRQ1 handler, not by the timer IRQ08
# breakpoint used to make this probe deterministic.
send "MEMDUMP 0824 004E 8\r"
wait_for_debug_message {Memory dump success} "memory dump completion"
puts stderr "CAPPO IRQ1 queue probe delivered raw scan byte 0x$scan"
interact
